# Copy to .env and replace both values with unique random strings. Never commit .env.
POSTGRES_DB=disaster_relief
POSTGRES_USER=relief
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET_KEY=replace-with-a-different-long-random-signing-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
DISPATCH_TOP_K=3
